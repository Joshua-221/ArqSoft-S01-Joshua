@{
    ViewData["Title"] = "Privacidad";
}
<div class="container mt-5 mb-5">
    <div class="panel-formulario">
        <h1 class="rgb-texto-lento mb-4" style="font-size: 2.5rem;"> Políticas de Privacidad</h1>
        
        <div style="color: var(--texto-suave); line-height: 1.8;">
            <h3 style="color: var(--neon-cian); font-family: 'Orbitron', monospace; margin-top: 2rem; margin-bottom: 1rem;">Información General</h3>
            <p>
                Esta aplicación <strong style="color: var(--neon-verde);">GAME-STOCK</strong> es una herramienta académica desarrollada para la gestión de catálogos de videojuegos como parte del curso de <strong>Ingeniería en Software</strong>.
            </p>

            <h3 style="color: var(--neon-cian); font-family: 'Orbitron', monospace; margin-top: 2rem; margin-bottom: 1rem;">Recopilación de Datos</h3>
            <p>
                 <strong>No se recopilan datos personales</strong> de los usuarios.<br/>
                 <strong>No se rastrea la actividad</strong> de navegación.<br/>
                 <strong>No se utilizan cookies</strong> de rastreo.

            <h3 style="color: var(--neon-cian); font-family: 'Orbitron', monospace; margin-top: 2rem; margin-bottom: 1rem;">Almacenamiento de Datos</h3>
            <p>
                 Los registros de videojuegos se almacenan <strong style="color: var(--neon-verde);">únicamente en la memoria local</strong> del servidor.<br/>
                 Los datos son <strong>volátiles</strong> y se resetean cuando se reinicia la aplicación.<br/>
                 No existe base de datos persistente externa.
            </p>

            <h3 style="color: var(--neon-cian); font-family: 'Orbitron', monospace; margin-top: 2rem; margin-bottom: 1rem;">Seguridad</h3>
            <p>
                Esta es una aplicación local con propósitos educativos. La seguridad no está optimizada para producción. 
                <strong style="color: var(--neon-verde);">No compartir datos sensibles</strong> en esta plataforma.
            </p>

            <h3 style="color: var(--neon-cian); font-family: 'Orbitron', monospace; margin-top: 2rem; margin-bottom: 1rem;">Contacto</h3>
            <p>
                Para consultas sobre esta aplicación, contactar a: <strong style="color: var(--neon-verde);">Joshua Isaí</strong><br/>
                Proyecto: <span style="color: var(--neon-purpura);">GAME-STOCK Catálogo de Videojuegos</span>
            </p>
        </div>

        <div style="margin-top: 3rem; padding: 1.5rem; border: 1px solid var(--borde-activo); border-radius: 8px; background: rgba(0, 212, 255, 0.05);">
            <p style="margin: 0; font-size: 0.9rem; color: var(--texto-apagado); text-align: center;">
                <i class="bi bi-shield-check me-2" style="color: var(--neon-verde);"></i>
                Última actualización: Mayo 2026
            </p>
        </div>
    </div>
</div>