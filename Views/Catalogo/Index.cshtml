@model IEnumerable<Catalogo.Models.Item>

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="rgb-title display-4">🎮 My Gamer Vault</h1>
        <p class="text-muted">Software Engineering Collection - Joshua Isaí</p>
    </div>

    <div class="d-flex justify-content-center mb-4">
        <div class="btn-group shadow-lg">
            <a asp-action="Index" class="btn btn-outline-info btn-sm">TODOS</a>
            @if (ViewBag.Generos != null)
            {
                foreach (var gen in ViewBag.Generos as List<string>)
                {
                    <a asp-action="Index" asp-route-genero="@gen" class="btn btn-outline-info btn-sm">@gen.ToUpper()</a>
                }
            }
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4 game-card-anim">
                <div class="card h-100 card-gamer text-white">
                    <div class="logo-container">
                        <span style="font-size: 4rem;">👾</span>
                    </div>
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--primary-neon)">@item.Titulo</h5>
                        <p class="small text-muted mb-3">@item.Genero.ToUpper() | @item.Ano</p>
                        <p class="card-text"><i class="bi bi-cpu"></i> <strong>SISTEMA:</strong> @item.Consola</p>
                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-primary w-100 mt-3 shadow-sm" 
                           style="background: var(--secondary-neon); border: none;">
                           CONFIGURACIÓN
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>