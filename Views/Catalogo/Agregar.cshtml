@model Catalogo.Models.Item

<div class="container mt-5 mb-5">
    <div class="panel-formulario">
        <h2 class="rgb-texto-lento mb-4" style="font-size: 2.2rem; text-align: center;">⚡ Agregar Nuevo Videojuego</h2>
        
        <form asp-action="Agregar" method="post">
            <div class="mb-3">
                <label class="form-label">Título</label>
                <input asp-for="Titulo" class="form-control" required placeholder="Ej: Devil May Cry 5" />
            </div>
            <div class="mb-3">
                <label class="form-label">Género</label>
                <input asp-for="Genero" class="form-control" required placeholder="Ej: Hack and Slash" />
            </div>
            <div class="mb-3">
                <label class="form-label">Año de Lanzamiento</label>
                <input asp-for="Ano" type="number" class="form-control" required placeholder="2001" />
            </div>
            <div class="mb-3">
                <label class="form-label">Consola</label>
                <input asp-for="Consola" class="form-control" required placeholder="Ej: PS5, Xbox Series X, PC" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="4" required placeholder="Describe el juego..."></textarea>
            </div>
            <div class="d-flex gap-2 justify-content-center mt-4">
                <button type="submit" class="btn btn-success px-5">
                    <i class="bi bi-check-circle me-2"></i>Guardar Juego
                </button>
                <a asp-action="Index" class="btn btn-secondary px-5">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>